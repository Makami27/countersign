{
  "name": "countersign",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "gate": "node scripts/gate.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/client/tsconfig.json",
    "test": "node --test --test-reporter=spec \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "test:core": "node --test --test-reporter=spec \"packages/core/test/*.test.ts\"",
    "test:live": "node --env-file=.env --test --test-reporter=spec --test-concurrency=1 \"packages/*/test/live/*.live.test.ts\"",
    "check:comments": "node scripts/check-no-comments.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "spikes": "pnpm --filter @countersign/spikes spikes",
    "agent": "node --env-file=.env apps/agent/src/main.ts",
    "web": "node --env-file=.env apps/web/src/main.ts",
    "testnet:pay": "node --env-file=.env apps/agent/src/testnetPayment.ts",
    "act1": "node --env-file=.env apps/agent/src/act1.ts",
    "build:web": "node scripts/build-web.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "subset-font": "2.9.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@mysten/wallet-standard": "0.21.34"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
